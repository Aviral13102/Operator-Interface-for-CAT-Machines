# Backend WebSocket URL.
#
# During development the Vite proxy (vite.config.js) forwards /ws to
# ws://localhost:8001/ws automatically, so you can leave this blank and the
# app will connect through the proxy.
#
# At integration time (Hour 10), set this to the real backend URL:
#   VITE_BACKEND_WS_URL=ws://your-ec2-host/ws
#
# Only a config change is needed — no code changes.
VITE_BACKEND_WS_URL=
